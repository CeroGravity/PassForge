{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrengthTestVectors",
  "description": "Test vectors for password strength evaluation across implementations.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["input", "expected"],
    "properties": {
      "input": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "password": {
            "type": "string",
            "description": "Synthetic test password (never use real credentials)."
          }
        },
        "additionalProperties": false
      },
      "expected": {
        "type": "object",
        "required": ["score"],
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4,
            "description": "Expected strength score (0=weakest, 4=strongest)."
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  }
}
